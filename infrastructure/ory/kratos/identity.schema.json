{
  "$id": "https://artical.local/schemas/author.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Author",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "Username",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Contact email",
          "maxLength": 254,
          "ory.sh/kratos": {
            "recovery": {
              "via": "email"
            },
            "verification": {
              "via": "email"
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Full name",
          "maxLength": 120
        }
      },
      "required": ["username", "email", "name"],
      "additionalProperties": false
    }
  }
}

# Copy to infrastructure/env/.env — that file is gitignored and never committed.
#   task setup
#
# Real secrets live on the host and in the managed host's env settings.
# See infrastructure/CLAUDE.md.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=artical
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=artical
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=artical
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_BUCKET=media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- core-engine ------------------------------------------------------------
API_PORT=3000
SWAGGER_ENABLED=true

# --- Kong -------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# Tenant API keys. Consumed by kong.yml via {vault://env/...}.
# Generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TECH_TENANT_KEY=replace-me
GAMING_TENANT_KEY=replace-me

# --- Ory: identity, tokens, permissions --------------------------------------
# Kratos and Oathkeeper are in the login path. Hydra and Keto run but nothing
# routes through them — see infrastructure/ory/*/README.md.
#
# Generate each secret separately (never reuse one across services):
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# Signs session cookies. Rotating it logs everyone out.
KRATOS_COOKIE_SECRET=replace-me
# Encrypts data at rest in Kratos. Rotating it makes existing encrypted values
# unreadable — this is NOT the same class of change as the cookie secret.
KRATOS_CIPHER_SECRET=replace-me
# Signs and encrypts Hydra's tokens. Rotating invalidates every issued token.
HYDRA_SYSTEM_SECRET=replace-me

KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434
HYDRA_PUBLIC_PORT=4444
HYDRA_ADMIN_PORT=4445
KETO_READ_PORT=4466
KETO_WRITE_PORT=4467
MAILSLURPER_UI_PORT=4436
MAILSLURPER_API_PORT=4437

# --- Backoffice --------------------------------------------------------------
BACKOFFICE_PORT=3001

# The seeded platform super admin. Created through the Kratos ADMIN api by
# `task seed:admin` — there is no self-service registration path.
#
# Username is the login identity; email is contact info and a recovery delivery
# address, NOT a credential (root CLAUDE.md §5). Kratos requires >= 12 chars and
# checks the password against HaveIBeenPwned, so a simple one is rejected.
#
# CHANGE THESE before anything reachable from outside your laptop.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@artical.local
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_PASSWORD=replace-me-at-least-12-chars

# --- Tenant sites (local dev containers only) --------------------------------
TECH_SITE_PORT=3100
GAMING_SITE_PORT=3200

# Browser-reachable base for stored media. In production this is the CDN-fronted
# media hostname — og:image must be fetchable by crawlers from the internet.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000

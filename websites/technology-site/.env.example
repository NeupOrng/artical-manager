# Copy to .env for local development. Never commit the real file.
# On the managed host these are set as NUXT_* environment variables.

# Gateway, NOT the API directly — the key is validated at Kong.
NUXT_API_BASE_URL=http://localhost:8000
# Must match TECH_TENANT_KEY in infrastructure/env/.env
NUXT_TENANT_KEY=replace-me
NUXT_REVALIDATE_SECRET=replace-me

NUXT_PUBLIC_SITE_URL=http://localhost:3100
NUXT_PUBLIC_SITE_NAME=Technology Site

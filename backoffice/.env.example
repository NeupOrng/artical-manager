# Copy to .env — that file is gitignored and never committed.
#
# Both values are SERVER-ONLY (they map to non-public runtimeConfig keys), so
# neither reaches the browser. Nuxt maps NUXT_FOO_BAR -> runtimeConfig.fooBar.

# The GATEWAY, not the API. Requests must pass through Kong and Oathkeeper to
# have an identity attached — pointing this straight at the API on :3000 skips
# authentication entirely and every call comes back 401.
NUXT_API_BASE_URL=http://localhost:8000

# Kratos' PUBLIC api, proxied under this app's origin at /.ory/*.
#
# NEVER the admin api on :4434. That one creates identities and impersonates
# people; exposing it through a route a browser can reach would hand anyone the
# ability to mint themselves an account.
#
# Through Kong, not straight to kratos:4433 — that way local development
# exercises the same gateway route production uses, so a broken `kratos-public`
# route fails here rather than after a deploy.
#
# NOTE: this file is only read when the backoffice runs on the HOST
# (`task dev:backoffice`). Under `task dev` it runs as a container and compose
# supplies these with Docker service names instead — compose `environment:` wins
# over a bind-mounted .env, because dotenv does not override variables already
# in process.env. See infrastructure/CLAUDE.md.
NUXT_KRATOS_PUBLIC_URL=http://localhost:8000/.ory

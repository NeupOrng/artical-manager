{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "monorepo": true,
  "root": "apps/api",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "deleteOutDir": false
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "tenant": {
      "type": "library",
      "root": "libs/tenant",
      "entryFile": "index",
      "sourceRoot": "libs/tenant/src",
      "compilerOptions": {
        "tsConfigPath": "libs/tenant/tsconfig.lib.json"
      }
    },
    "author": {
      "type": "library",
      "root": "libs/author",
      "entryFile": "index",
      "sourceRoot": "libs/author/src",
      "compilerOptions": {
        "tsConfigPath": "libs/author/tsconfig.lib.json"
      }
    },
    "platform-admin": {
      "type": "library",
      "root": "libs/platform-admin",
      "entryFile": "index",
      "sourceRoot": "libs/platform-admin/src",
      "compilerOptions": {
        "tsConfigPath": "libs/platform-admin/tsconfig.lib.json"
      }
    },
    "article": {
      "type": "library",
      "root": "libs/article",
      "entryFile": "index",
      "sourceRoot": "libs/article/src",
      "compilerOptions": {
        "tsConfigPath": "libs/article/tsconfig.lib.json"
      }
    },
    "media": {
      "type": "library",
      "root": "libs/media",
      "entryFile": "index",
      "sourceRoot": "libs/media/src",
      "compilerOptions": {
        "tsConfigPath": "libs/media/tsconfig.lib.json"
      }
    },
    "category": {
      "type": "library",
      "root": "libs/category",
      "entryFile": "index",
      "sourceRoot": "libs/category/src",
      "compilerOptions": {
        "tsConfigPath": "libs/category/tsconfig.lib.json"
      }
    }
  }
}

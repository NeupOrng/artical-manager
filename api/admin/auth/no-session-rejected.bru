meta { name: Refusal — no session must 401, type: http, seq: 2 }

get { url: {{adminBase}}/me, body: none, auth: none }

docs {
  No cookie at all. Oathkeeper must reject this before it reaches NestJS.

  Expect 401. A 200 means the admin surface is not actually behind the
  cookie_session authenticator, and every admin endpoint is open.
}
